# Copy to .env for local overrides. .env is gitignored.

POSTGRES_DB=vaultscale
POSTGRES_USER=vaultscale
POSTGRES_PASSWORD=change_me_in_real_deployment

AUDIT_POSTGRES_DB=audit_db
AUDIT_POSTGRES_USER=audituser
AUDIT_POSTGRES_PASSWORD=change_me_in_real_deployment
AUDIT_KAFKA_CONSUMER_GROUP=vaultscale-audit-service

JWT_SECRET=replace_with_a_long_random_secret_before_deployment
JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host-side tools use localhost:9092; containers use kafka:29092 via Compose.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

GRAFANA_ADMIN_PASSWORD=change_me_in_real_deployment
